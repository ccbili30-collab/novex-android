      "modules": [
        {
          "id": "origin-world-experience",
          "type": "worldExperience",
          "title": "世界经历",
          "presentation": "article",
          "content": {
            "text": "苏晚晴幼承家学，十六岁开始独立记录脉案。临川疫病期间，她曾在药材断绝的情况下重新调整方剂，因此得到百姓信任，也第一次意识到医术会受到权力、交通和资源左右。疫病结束后，她离开故乡游历各地，在山村、渡口和战后营地行医。一次追查异常寒症时，她发现病因与北境流出的灵脉碎片有关，由此踏上通往云岚山的道路。"
          }
        },
        {
          "id": "origin-quotes",
          "type": "quotes",
          "title": "语录",
          "presentation": "quoteCards",
          "content": {
            "items": [
              {"id": "quote-calm", "form": "平静", "text": "医者能做的不是替人决定，而是让他还有机会自己决定。"},
              {"id": "quote-emergency", "form": "危急", "text": "先止血。其他的，等人活下来再说。"},
              {"id": "quote-friend", "form": "亲近", "text": "药确实苦了些，我给你备了梅子。别趁我转身就倒掉。"}
            ]
          }
        },
        {
          "id": "origin-skills",
          "type": "skills",
          "title": "技能",
          "presentation": "compactList",
          "content": {
            "items": [
              {"id": "skill-diagnosis", "name": "望闻问切", "summary": "从细微体征和生活环境中判断病因。"},
              {"id": "skill-needles", "name": "银针封脉", "summary": "暂时稳定出血、疼痛与紊乱灵息。"},
              {"id": "skill-herbs", "name": "百草辨识", "summary": "识别药性、毒性以及相互替代关系。"},
              {"id": "skill-calm", "name": "临危持静", "summary": "越是危险，越能维持清晰的处理次序。"}
            ]
          }
        },
