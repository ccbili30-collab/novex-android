# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# iOS
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)
deps/alpine/

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.
deps/ffmpeg-6.1.2/

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

src-bak/
src/android/app/src/main/assets/bashism/

# Locally collected APKs and emulator screenshots used for product review.
artifacts/

# Local release staging; authoritative binaries live in GitHub Releases.
dist/

# Xcode debugger state (breakpoints) — personal dev state, never track
xcshareddata/xcdebugger/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# Debug-only skill assets staged by scripts/gen_debug_skill_android.sh from
# .claude/skills/debug-server/; regenerated on every debug build.
src/android/app/src/debug/assets/debug-skill/

deps/lame-build/
deps/lame-3.100/**/.libs/

# LAME autotools output (./configure writes absolute build paths into these)
deps/lame-3.100/**/Makefile
deps/lame-3.100/config.status
deps/lame-3.100/config.h
deps/lame-3.100/libtool
deps/lame-3.100/**/stamp-h1
deps/lame-3.100/**/*.la
deps/lame-3.100/**/*.lai
deps/lame-3.100/**/.libs/
deps/lame-3.100/**/.deps/

# Local diagnostics, original user bundles and reproducible temporary outputs.
/local/
/tmp/

# [P2.5 沙箱退役] 二进制遗物防再犯：R2 删除时误删了忽略规则，导致工作区
# 磁盘残留被 add -A 扫回仓库（2026-10-01 beta.105/106 污染事故）。这些路径
# 永远不该出现在 git 树里——scripts/tests/novex_forbidden_artifacts_test.sh 有门禁。
src/android/app/src/main/assets/alpine-minirootfs.tar*
src/android/app/src/main/assets/proot-aarch64
src/android/app/src/main/jniLibs/arm64-v8a/libproot*.so
src/android/app/src/main/jniLibs/arm64-v8a/libtalloc.so
src/android/app/src/main/jniLibs/arm64-v8a/libandroid-shmem.so
